#!/usr/bin/env bash
#
# tools/release-notes: the notes of a release, grouped by the part of
# the project each commit changed. Run it from the root of the
# repository, with an optional range.
#
#   tools/release-notes            # since the tag before HEAD
#   tools/release-notes v0.3.0..HEAD
#
# A commit names a problem, so a section reads as the list of problems
# a release settled in that part. A commit that closes an issue is a
# fix wherever its files are, and a commit that changed two parts is
# named once, under the first part it matches.
#
# License: GNU GPL 3.0

set -euo pipefail

# Each line is a section and the paths that belong to it, in the order
# a commit is tested against them. The names reach a reader of the
# release page, so they say the part rather than the directory.
AREAS='Analyzer|^(src/|tests/[^/]*\.rs$|tools/vim-tables$|tools/fixture-json)
Front end|^(plugin/|autoload/|import/|tests/stub/)|\.vim$
CI and release|^(\.github/|tools/|Cargo\.(toml|lock)$|\.gitignore$)
Documentation|^(docs?/)|\.md$'

# The section a commit with no path of any section falls to.
REST='Other changes'

# Written by the workflow itself, or by a merge, rather than by anyone
# releasing.
SKIP='^(Merge |docs: regenerate Vimdoc)'

# FUNCTION: The issue a commit names, as the reader sees it. A commit
# that closes one names it with `fixes:`, and one that serves an open
# issue names it with `related:`, which is still what the line is
# about.
issue() {
  local body
  body=$(git log -1 --format='%b' "$1")

  printf '%s\n' "$body" \
    | sed -n -E 's/^(fixes|related):[[:space:]]*(#[0-9]+).*/\2/p' \
    | head -1
}

# FUNCTION: The section a commit belongs to.
section() {
  local sha=$1 files line name pats

  if git log -1 --format='%b' "$sha" | grep -q '^fixes:'; then
    printf 'Fixes\n'
    return
  fi

  if git log -1 --format='%s' "$sha" | grep -q '^Bump '; then
    printf 'Dependencies\n'
    return
  fi

  files=$(git show --name-only --format='' "$sha")

  while IFS= read -r line; do
    name=${line%%|*}
    pats=${line#*|}

    if printf '%s\n' "$files" | grep -qE "$pats"; then
      printf '%s\n' "$name"
      return
    fi
  done <<< "$AREAS"

  printf '%s\n' "$REST"
}

range=${1:-}

if [ -z "$range" ]; then
  prev=$(git describe --tags --abbrev=0 'HEAD^' 2> /dev/null || true)
  range=${prev:+$prev..}HEAD
fi

# One pass over the range, which writes a line per commit into the file
# of its section, so that the order of the sections is this script's
# and the order inside one is the order the work was done in.
# The template is written out, because the -t form of one platform is
# not the -t form of the other, and this runs on both.
dir=$(mktemp -d "${TMPDIR:-/tmp}/ghostcode-notes.XXXXXX")
trap 'rm -rf "$dir"' EXIT

while IFS= read -r sha; do
  [ -n "$sha" ] || continue

  subject=$(git log -1 --format='%s' "$sha")

  if printf '%s\n' "$subject" | grep -qE "$SKIP"; then
    continue
  fi

  at=$(issue "$sha")
  printf -- '- %s%s\n' "$subject" "${at:+ ($at)}" \
    >> "$dir/$(section "$sha")"
done <<< "$(git log --reverse --no-merges --format='%H' "$range")"

while IFS= read -r name; do
  [ -s "$dir/$name" ] || continue

  printf '### %s\n\n' "$name"
  cat "$dir/$name"
  printf '\n'
done <<< "$(printf 'Fixes\n%s\n%s\nDependencies\n' \
  "$(printf '%s\n' "$AREAS" | cut -d'|' -f1)" "$REST")"
