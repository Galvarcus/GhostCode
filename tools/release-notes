#!/usr/bin/env python3

"""tools/release-notes: the notes of a release, one line per issue.

Run it from the root of the repository, with an optional range.

    tools/release-notes                 # since the tag before HEAD
    tools/release-notes v0.3.0..HEAD

A release of this project is many commits against few issues: the
subject of each states the problem it settled, so thirty of them
against one issue read as thirty statements of that issue. The page
therefore names the issue once, with the count of the commits behind
it, and leaves the commits in the history where the record belongs.

License: GNU GPL 3.0
"""

import re
import subprocess
import sys

# Each section is a name and the paths that belong to it, in the order
# a commit is tested against them. The names reach a reader of the
# release page, so they name the part rather than the directory.
AREAS = [
    ("Analyzer", r"^(src/|tests/[^/]*\.rs$|tools/vim-tables$|tools/fixture)"),
    ("Front end", r"^(plugin/|autoload/|import/|tests/stub/)|\.vim$"),
    ("CI and release", r"^(\.github/|tools/|Cargo\.(toml|lock)$|\.gitignore$)"),
    ("Documentation", r"^(docs?/)|\.md$"),
]

FIXES = "Fixes"
DEPS = "Dependencies"
REST = "Other changes"

# Written by the workflow itself, or by a merge, rather than by anyone
# releasing.
SKIP = re.compile(r"^(Merge |docs: regenerate Vimdoc)")

# A commit that closes an issue names it with `fixes:`, and one that
# serves an open issue names it with `related:`. Both say what the line
# is about; only the first says the issue is settled.
TRAILER = re.compile(r"^(fixes|related):\s*#(\d+)", re.MULTILINE)

RECORD = "\x1e"
FIELD = "\x1f"


def run(*args):
    """FUNCTION: One command, as text, or the empty string where it
    failed or is not installed. A range with no previous tag, and a
    machine with no gh, are both ordinary rather than errors."""
    try:
        done = subprocess.run(
            args, capture_output=True, text=True, check=False
        )
    except OSError:
        return ""

    return done.stdout.strip() if done.returncode == 0 else ""


def git(*args):
    """FUNCTION: One git command, as text."""
    return run("git", *args)


def title(issue, fallback):
    """FUNCTION: The title of an issue, which states its problem better
    than any one of the commits against it. Without the network, or
    without gh, the newest of those commits stands in, so that a
    release is never held up by a call to GitHub."""
    said = run("gh", "issue", "view", issue, "--json", "title", "--jq", ".title")

    return said if said else fallback


def area_of(sha):
    """FUNCTION: The section a commit's files put it in. A commit that
    changed two parts counts for the first of them, so that nothing is
    named twice."""
    files = git("show", "--name-only", "--format=", sha).splitlines()

    for name, pattern in AREAS:
        if any(re.search(pattern, f) for f in files):
            return name

    return REST


def dominant(areas):
    """FUNCTION: The section that holds most of an issue's commits. A
    tie goes to the section that comes first in the table, so that the
    answer never depends on the order the commits were made in."""
    return max(
        (a[0] for a in AREAS if a[0] in areas),
        key=areas.count,
        default=REST,
    )


def commits(span):
    """FUNCTION: Every commit of the range that a reader should see, as
    (sha, subject, body), oldest first."""
    out = git(
        "log",
        "--reverse",
        "--no-merges",
        f"--format=%H{FIELD}%s{FIELD}%b{RECORD}",
        span,
    )

    for record in out.split(RECORD):
        parts = record.strip("\n").split(FIELD)

        if len(parts) == 3 and parts[0] and not SKIP.match(parts[1]):
            yield parts


def span_of(given):
    """FUNCTION: The range to read: the one asked for, or everything
    since the tag before HEAD."""
    if given:
        return given

    prev = git("describe", "--tags", "--abbrev=0", "HEAD^")

    return f"{prev}..HEAD" if prev else "HEAD"


def main():
    span = span_of(sys.argv[1] if len(sys.argv) > 1 else "")
    lines = {}
    issues = {}
    order = []

    for sha, subject, body in commits(span):
        found = TRAILER.search(body)

        if not found:
            where = DEPS if subject.startswith("Bump ") else area_of(sha)
            lines.setdefault(where, []).append(f"- {subject}")
            continue

        kind, number = found.group(1), found.group(2)
        seen = issues.setdefault(
            number, {"count": 0, "closed": False, "areas": [], "last": ""}
        )

        if not seen["count"]:
            order.append(number)

        seen["count"] += 1
        seen["closed"] = seen["closed"] or kind == "fixes"
        seen["areas"].append(area_of(sha))
        seen["last"] = subject

    for number in order:
        seen = issues[number]
        where = FIXES if seen["closed"] else dominant(seen["areas"])
        said = title(number, seen["last"])
        count = f", {seen['count']} commits" if seen["count"] > 1 else ""
        lines.setdefault(where, []).append(f"- {said} (#{number}){count}")

    for name in [FIXES] + [a[0] for a in AREAS] + [REST, DEPS]:
        if name in lines:
            print(f"### {name}\n")
            print("\n".join(lines[name]))
            print()


if __name__ == "__main__":
    main()
