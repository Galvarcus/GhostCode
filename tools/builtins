#!/usr/bin/env bash
#
# tools/builtins: regenerate the table of Vim's own function names
# from a Vim help file, and print what changed.
#
#   tools/builtins /path/to/runtime/doc/builtin.txt
#
# Run it from the root of the repository.
#
# The names come from the Overview section of `builtin.txt`, which
# lists one function per line against the left margin. The generated
# file is committed, so the tree carries the table and a reader needs
# no Vim to hand.
#
# CI does not check the table against the Vim of a runner. A runner's
# version differs from the floor the plugin promises, and a function
# Vim adds later is simply still counted, which is the safe direction
# for a change that suppresses references.
# REFERENCE: https://github.com/Galvarcus/GhostCode/issues/12
#
# License: GNU GPL 3.0

set -uo pipefail

doc=${1:-}
out=src/lang/vim9/builtins.rs

if [ -z "$doc" ]; then
  echo "usage: tools/builtins /path/to/runtime/doc/builtin.txt" >&2
  exit 2
fi

if [ ! -r "$doc" ]; then
  echo "tools/builtins: cannot read $doc" >&2
  exit 1
fi

if [ ! -d "$(dirname "$out")" ]; then
  echo "tools/builtins: run it from the root of the repository" >&2
  exit 1
fi

# The file states the version it documents on its first line, as
# `*builtin.txt*	For Vim version 9.2.  Last change: ...`.
version=$(sed -n '1s/.*For Vim version \([0-9.]*[0-9]\).*/\1/p' "$doc")

if [ -z "$version" ]; then
  echo "tools/builtins: $doc names no Vim version on its first line" >&2
  exit 1
fi

# The table is searched by `binary_search`, which orders names by
# their bytes, so the sort has to as well. A locale's collation can
# rank an underscore differently, which would put the table in an
# order the search reads wrongly.
names=$(
  sed -n '/\*builtin-function-list\*/,/\*builtin-function-details\*/p' "$doc" |
    grep -oE '^[a-z][a-z0-9_]*\(' |
    tr -d '(' |
    LC_ALL=C sort -u
)

count=$(printf '%s\n' "$names" | grep -c .)

if [ "$count" -lt 100 ]; then
  echo "tools/builtins: $doc yielded only $count names, which is not a list" >&2
  exit 1
fi

tmp=$(mktemp -t ghostcode-builtins)
trap 'rm -f "$tmp"' EXIT

{
  cat <<RUST
//! The names of the functions Vim defines, which a project cannot
//! declare under the same name: Vim refuses a lowercase \`def\` with
//! E1267 and a lowercase funcref variable with E704.
//!
//! Generated by \`tools/builtins\` from the Overview section of the
//! \`runtime/doc/builtin.txt\` of Vim $version. Never edited by hand:
//! run the tool again against a newer help file.
//!
//! License: GNU GPL 3.0

/// Every function Vim defines, in order, so that a lookup is a binary
/// search of $count names rather than a walk of them.
const NAMES: &[&str] = &[
RUST
  printf '%s\n' "$names" | sed 's/.*/    "&",/'
  cat <<'RUST'
];

/// FUNCTION: Whether Vim defines a function of this name.
pub fn has(name: &str) -> bool {
    NAMES.binary_search(&name).is_ok()
}

#[cfg(test)]
mod tests {
    use super::NAMES;

    /// The lookup is a binary search, which answers an unordered
    /// table wrongly rather than slowly, and a name listed twice
    /// would mean the help file was read with the wrong bounds.
    #[test]
    fn the_table_is_ordered_and_each_name_appears_once() {
        assert!(NAMES.windows(2).all(|pair| pair[0] < pair[1]));
    }
}
RUST
} > "$tmp"

if [ -r "$out" ] && diff -q "$out" "$tmp" >/dev/null; then
  echo "tools/builtins: $out already holds $count names for Vim $version"
  exit 0
fi

old=/dev/null
if [ -r "$out" ]; then
  old=$out
fi

diff -u "$old" "$tmp" | head -40 || true

if ! cp "$tmp" "$out"; then
  echo "tools/builtins: could not write $out" >&2
  exit 1
fi

echo "tools/builtins: wrote $count names for Vim $version to $out"
