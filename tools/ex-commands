#!/usr/bin/env bash
#
# tools/ex-commands: regenerate the table of Vim's own command names
# from a Vim help file, and print what changed.
#
#   tools/ex-commands /path/to/runtime/doc/index.txt
#
# Run it from the root of the repository.
#
# The names come from the EX commands section of `index.txt`, whose
# every line names one command. The generated file is committed, so
# the tree carries the table and a reader needs no Vim to hand.
#
# Two kinds of name are left out. An uppercase one, of which Vim has
# three, because a project's own function has to start with a capital
# and would collide. And a name of one character, of which Vim has
# three, because `k`, `t` and `z` are worth almost nothing in a
# plugin's source and are the names a project is most likely to reuse.
# Leaving them out is also what makes a scope prefix safe, since every
# one of those is a single letter.
# REFERENCE: https://github.com/Galvarcus/GhostCode/issues/12
#
# License: GNU GPL 3.0

set -uo pipefail

doc=${1:-}
out=src/lang/vim9/excmds.rs

if [ -z "$doc" ]; then
  echo "usage: tools/ex-commands /path/to/runtime/doc/index.txt" >&2
  exit 2
fi

if [ ! -r "$doc" ]; then
  echo "tools/ex-commands: cannot read $doc" >&2
  exit 1
fi

if [ ! -d "$(dirname "$out")" ]; then
  echo "tools/ex-commands: run it from the root of the repository" >&2
  exit 1
fi

# The file states the version it documents on its first line, as
# `*index.txt*	For Vim version 9.2.  Last change: ...`.
version=$(sed -n '1s/.*For Vim version \([0-9.]*[0-9]\).*/\1/p' "$doc")

if [ -z "$version" ]; then
  echo "tools/ex-commands: $doc names no Vim version on its first line" >&2
  exit 1
fi

# Each row of the section reads `|:tag|<tab>:c[ommand]<tab>action`,
# and the second field holds the name with its optional part in
# brackets. The table is searched by `binary_search`, which orders
# names by their bytes, so the sort has to as well.
names=$(
  sed -n '/\*ex-cmd-index\*/,$p' "$doc" |
    awk -F'\t+' '/^\|:/ {print $2}' |
    sed 's/^://; s/[][]//g' |
    grep -E '^[a-z][a-z0-9_]+$' |
    LC_ALL=C sort -u
)

count=$(printf '%s\n' "$names" | grep -c .)

if [ "$count" -lt 100 ]; then
  echo "tools/ex-commands: $doc yielded only $count names, which is not a list" >&2
  exit 1
fi

tmp=$(mktemp -t ghostcode-excmds)
trap 'rm -f "$tmp"' EXIT

{
  cat <<RUST
//! The names of Vim's own commands, which a project cannot declare
//! under the same name: Vim refuses a lowercase \`def\` with E1267 and
//! a lowercase funcref variable with E704. A name of one character
//! and a name that starts with a capital are left out, for the
//! reasons \`tools/ex-commands\` gives.
//!
//! Generated by \`tools/ex-commands\` from the EX commands section of
//! the \`runtime/doc/index.txt\` of Vim $version. Never edited by
//! hand: run the tool again against a newer help file.
//!
//! License: GNU GPL 3.0

/// Every command Vim defines, in order, so that a lookup is a binary
/// search of $count names rather than a walk of them.
const NAMES: &[&str] = &[
RUST
  printf '%s\n' "$names" | sed 's/.*/    "&",/'
  cat <<'RUST'
];

/// FUNCTION: Whether Vim defines a command of this name.
pub fn has(name: &str) -> bool {
    NAMES.binary_search(&name).is_ok()
}

#[cfg(test)]
mod tests {
    use super::NAMES;

    /// The lookup is a binary search, which answers an unordered
    /// table wrongly rather than slowly, and a name listed twice
    /// would mean the help file was read with the wrong bounds.
    #[test]
    fn the_table_is_ordered_and_each_name_appears_once() {
        assert!(NAMES.windows(2).all(|pair| pair[0] < pair[1]));
    }

    /// A scope prefix is a single letter, and a single letter is left
    /// out of the table, which is what lets `g:flag = 1` keep the
    /// reference the project is owed.
    #[test]
    fn no_name_is_one_character_long() {
        assert!(NAMES.iter().all(|name| name.len() > 1));
    }
}
RUST
} > "$tmp"

if [ -r "$out" ] && diff -q "$out" "$tmp" >/dev/null; then
  echo "tools/ex-commands: $out already holds $count names for Vim $version"
  exit 0
fi

old=/dev/null
if [ -r "$out" ]; then
  old=$out
fi

diff -u "$old" "$tmp" | head -40 || true

if ! cp "$tmp" "$out"; then
  echo "tools/ex-commands: could not write $out" >&2
  exit 1
fi

echo "tools/ex-commands: wrote $count names for Vim $version to $out"
